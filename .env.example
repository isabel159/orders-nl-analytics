# Copia este archivo a .env y rellena los valores. .env NUNCA se sube al repositorio.

# PostgreSQL (usuario administrador: crea tablas y carga datos)
POSTGRES_USER=orders_admin
POSTGRES_PASSWORD=
POSTGRES_DB=orders
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Rol de solo lectura que usa la API (se crea al cargar los datos)
READONLY_USER=app_readonly
READONLY_PASSWORD=

# Claude en Azure AI Foundry
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
LLM_MODEL=
