# Copia este archivo a .env y rellena los valores. .env NUNCA se sube al repositorio.

# PostgreSQL (usuario administrador: crea tablas y carga datos)
POSTGRES_USER=orders_admin
POSTGRES_PASSWORD=
POSTGRES_DB=orders
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Rol de solo lectura que usa la API (se crea al cargar los datos)
READONLY_USER=app_readonly
READONLY_PASSWORD=

# LLM: Azure OpenAI (recurso de Azure AI Foundry)
# Endpoint del recurso, p. ej. https://<tu-recurso>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Nombre del deployment (no del modelo), p. ej. gpt-5-mini
AZURE_OPENAI_DEPLOYMENT=
# Opcionales
LLM_TIMEOUT_SECONDS=60
LLM_REASONING_EFFORT=low
